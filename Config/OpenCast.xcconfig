// Build settings for the OpenCast app target.
//
// GEMINI_API_KEY powers ad detection and Chapters & Summary. It stays blank
// in git; put the real key in Config/Secrets.xcconfig (git-ignored, copied
// from Config/Secrets.xcconfig.example). The key is embedded in the built app.
GEMINI_API_KEY =

// NOTIFICATIONS_WORKER is the host (and optional path) of your self-hosted
// Server/NotificationsWorker, without "https://" because xcconfig treats "//"
// as a comment. Blank keeps new-episode notifications on device.
NOTIFICATIONS_WORKER =

#include? "Secrets.xcconfig"
