// Copy to Config/Secrets.xcconfig (git-ignored) and set your Gemini API key.
// xcconfig treats "//" as a comment, so the value must not contain it.
GEMINI_API_KEY = your-gemini-api-key

// Optional: your NotificationsWorker host and path, without "https://".
// Use NOTIFICATIONS_WORKER[config=Debug] for a separate development lane.
// NOTIFICATIONS_WORKER = notifications.example.com
