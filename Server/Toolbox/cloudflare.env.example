# Copy to cloudflare.env (git-ignored) and fill in. wrangler login can't
# complete its browser callback inside the container, so use an API token:
# dash.cloudflare.com → My Profile → API Tokens, with Workers Scripts, D1,
# Workers R2 Storage, Queues, SSL and Certificates (mTLS) and, for a custom
# domain, Workers Routes / Zone permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
